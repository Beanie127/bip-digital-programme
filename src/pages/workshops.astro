---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ScriptFave from '../components/ScriptFave.astro';
import Timetable2 from '../components/Timetable2.astro';
const workshops = await getCollection('workshops');
const people = await getCollection('people');
const sessions = [1, 2, 3, 4, 5];
---

<Layout title="Workshops">
	<p>
		There are five workshop slots throughout the weekend: three on Saturday,
		and two on Sunday. We aim to programme a mix of styles and topics,
		looking at specific formats, performance skills and genres. There’s also
		a jam option in every session: no feedback, just play!
	</p>
	<p>
		This schedule tool lets you favourite a workshop for each session. This
		does not guarantee you a place, it's just for planning your weekend!
	</p>
	<p>
		You can <a href="/schedule-1page.pdf"
			>download a PDF of the timetable here</a
		> to print off at home, or keep on your phone for easy reference.
	</p>
	{
		sessions.map((session) => (
			<section>
				<h2 id={`session-${session}`}>Session {session}</h2>
				{workshops
					.filter((workshop) => workshop.data.sessions[session - 1])
					.map(async (workshop) => {
						const { Content } = await render(workshop);
						return (
							<details
								name={`session-${session}`}
								id={`session-${session}-${workshop.id}`}>
								<summary>{workshop.data.title}</summary>
								<p class="subtitle">
									in {workshop.data.sessions[session - 1]}{' '}
									with{' '}
									{typeof workshop.data.host == 'string' ?
									<a href={`/people/${workshop.data.host}`}>
										{
											people.find(
												(person) =>
													person.id ==
													workshop.data.host,
											)?.data.name
										}
									</a>
								:	workshop.data.host.map((host) => (
										<a href={`/people/${host}`}>
											{
												people.find(
													(person) =>
														person.id == host,
												)?.data.name
											}
										</a><span>{workshop.data.host.indexOf(host) + 1 < workshop.data.host.length ? " and " :""}</span>
									))
								}
								</p>
								<Content />
								<button
									class="favourite"
									data-favourite={`session-${session}-${workshop.id}`}>
									Favourite
								</button>
							</details>
						);
					})}
			</section>
		))
	}
	<Timetable2 />
	<style>
		section {
			padding-block: 1rem;
			border-radius: 5px;
		}

		h3 {
			margin-block-end: 0;
		}

		h3 + p {
			margin-block-start: 0;
		}
	</style>
	<ScriptFave />
</Layout>
