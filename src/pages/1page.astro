	<style>
		html {
			font-size: 12pt;
		}
		header {
			display: none !important;
		}
		main {
			max-inline-size: 100% !important;
			aspect-ratio: 1 / sqrt(2);
		}
		h1,
		h2 {
			margin-block: 0;
		}

		table {
			inline-size: 100%;
			table-layout: fixed;
			border-collapse: separate;
			border-spacing: 2px;
			break-inside: avoid-page;
		}

		table:not(:first-of-type) {
			margin-block-start: 2rem;
		}

		td,
		th {
			text-align: center;
			position: relative;
			border-radius: 8px;
			padding: 0.5ch;
			text-wrap: balance;
			font-variant-numeric: lining-nums;
		}

		td:has(time) {
			max-inline-size: 5ch;
		}

		th:not(:has(h2)) {
			font-weight: 900;
			font-variant: small-caps;
			background: hsl(0 0% 90%);
		}

		td:first-of-type,
		th:first-of-type {
			text-align: end;
			inline-size: 5ch;
			font-weight: bold;
			color: #aaa;
			background: none;
		}

		td.meal {
			background: hsl(90 40% 70%);
			background: var(--green);
		}

		td.workshop {
			background: hsl(0 40% 80%);
			background: var(--pink, hsl(0 100% 90%));
			font-weight: 600;

			& em {
				font-weight: 400;
				display: block;
			}
		}

		td.group {
			background: hsl(40 70% 75%);
			background: var(--yellow);
		}

		td.admin {
			background: hsl(180 40% 80%);
			background: var(--blue);
		}
	</style>
</Layout>
