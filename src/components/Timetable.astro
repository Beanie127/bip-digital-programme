        flex: 1 1 100%;
        align-content: center;
        text-align: center;
    }

    .session :where(a) {
        text-align: center;
        place-content: center;
        text-decoration: none;
        color: inherit;
    }

    .session[data-duration="2"] {
        min-block-size: 3.5lh;
    }
    .session[data-duration="3"] {
        min-block-size: 4.5lh;
    }
    .session[data-duration="4"] {
        min-block-size: 5.5lh;
    }

