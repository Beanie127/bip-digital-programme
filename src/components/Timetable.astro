        --session-color: var(--green);
    }

    .session.workshop {
        --session-color: var(--pink);
    }

    .session.group {
        --session-color: var(--yellow);
    }

    .session.admin {
        --session-color: var(--blue);
    }

    time {
        font-family: "Maple Mono";
        flex: 0 0 min-content;
        padding: 1ch;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: light-dark(
            hsl(from var(--session-color) h s calc(l - 10)),
            hsl(from var(--session-color) h s calc(l + 10))
        );
        font-size: 0.75rem;
        line-height: 0.8;
        text-align: center;
        font-variant-numeric: tabular-nums lining-nums;
    }

    .has-fave::before {
        content: "\2605";
    }
</style>
<script is:inline>
    const favourites = document.querySelectorAll(".favourite");
    const times = document.querySelectorAll("time");

    function updateFavouriteMarkers() {
        favourites.forEach((favourite) => {
            const data = JSON.parse(localStorage.getItem("favourites"));
            const session = favourite.dataset.session;
            const fave = data[session];
            if (fave) {
                favourite.textContent = fave.name;
                favourite.classList.add("has-fave");
            } else {
                favourite.textContent = "";
                favourite.classList.remove("has-fave");
            }
        });
    }

    function updateTimeMarker() {
        const moment = new Date();
        const currentEvent =
            Array.from(times).findLast(
                (time) => new Date(time.attributes.datetime.value) < moment,
            ) || times[0];
        const activeSession = currentEvent.parentElement;
        if (activeSession.classList.contains("is-current")) return;
        document.querySelector(".is-current")?.classList.remove("is-current");
        activeSession.classList.add("is-current");
    }

    document.addEventListener("DOMContentLoaded", () => {
        updateTimeMarker();
        updateFavouriteMarkers();
        setInterval(updateTimeMarker, 10000);
    });

    // update favourites immediately when someone navigates back to the schedule via the browser
    window.addEventListener("pageshow", updateFavouriteMarkers);
</script>
