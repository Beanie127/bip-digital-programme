---
const { title } = Astro.props;
---

<header>
    <h1>{title}</h1>
    <button id="btn-open-nav" popovertarget="nav-menu">
        Menu
    </button>
</header>
<nav id="nav-menu" popover>
    <ul>
        <li>
            <a href="/">Schedule</a>
        </li>
        <li>
            <a href="/workshops">Workshops</a>
        </li>
        <li>
            <a href="/entertainment">Entertainment</a>
        </li>
        <li>
            <a href="/welfare">Participant Welfare</a>
        </li>
        <li>
            <a href="/venue-travel">Venue & Travel</a>
        </li>
        <li>
            <a href="/feedback-changes">Feedback & Changes</a>
        </li>
        <li>
            <a href="/faqs">FAQs</a>
        </li>
        <li>
            <a href="/useful-contacts">Useful Contacts</a>
        </li>
    </ul>
</nav>
<style>
    header {
        position: sticky;
        display: flex;
        justify-content: space-between;
        align-items: center;
        inset: 0;
        inset-block-end: auto;
        background: var(--background);
        z-index: 5;
        border-block-end: 1px solid gray;
        min-block-size: 3rem;
    }

    h1 {
        line-height: 1;
        margin: 0;
        padding: 10px;
        padding-block-start: 5px;
        font-size: 1.75rem;
    }
    button {
        background: 0;
        border-radius: 0;
        padding-inline: 1rem;
        border: 0;
        border-inline-start: thin solid gray;
        align-self: stretch;
        text-transform: uppercase;
        font-weight: 500;
        font-size: 1.1rem;
        transition: all 150ms;
        anchor-name: --open-menu;
    }

    html:has(:popover-open) button {
        background: var(--red);
        color: white;
        box-shadow: inset 0 0 5px var(--purple);
    }

    nav:popover-open {
        position: fixed;
        inset: unset;
        inset-block-start: calc(anchor(--open-menu bottom));
        display: flex;
        flex-direction: column;
        place-items: center;
        justify-content: center;
        inset-inline-end: 0;
        background: var(--background);
        border: thin solid gray;
        padding: 0;
    }

    ul {
        margin: 0;
        list-style: none;
        padding: 0;
    }
    a {
        display: block;
        text-decoration: none;
        padding: 0.5rem;
    }
    li {
        align-content: center;
        padding: 0;
        margin: 0;
    }
    li + li {
        border-block-start: thin solid gray;
    }
</style>
